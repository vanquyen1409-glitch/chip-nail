---
/**
 * Hiển thị văn bản (English-only). Giữ prop `vi` cho tương thích nơi gọi cũ
 * nhưng không render. br=true để đổi \n thành xuống dòng.
 */
interface Props {
  vi?: string;
  en: string;
  br?: boolean;
}
const { en, br = false } = Astro.props;
const fmt = (s: string) => (br ? s.replace(/\n/g, '<br>') : s);
---
<span set:html={fmt(en)}></span>
