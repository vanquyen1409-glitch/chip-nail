---
/**
 * Văn bản song ngữ. Render cả 2 ngôn ngữ, CSS ẩn ngôn ngữ không chọn
 * (theo html[data-lang]) -> không nhấp nháy. Dùng: <T vi="..." en="..." />
 * br=true để đổi \n thành xuống dòng.
 */
interface Props {
  vi: string;
  en: string;
  br?: boolean;
}
const { vi, en, br = false } = Astro.props;
const fmt = (s: string) => (br ? s.replace(/\n/g, '<br>') : s);
---
<span data-l="vi" set:html={fmt(vi)}></span><span data-l="en" set:html={fmt(en)}></span>
