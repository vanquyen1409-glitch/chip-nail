---
// Nút tái dùng. variant: 'primary' | 'outline' | 'ghost'. Render <a> nếu có href.
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  [key: string]: any;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  class: cls = '',
  type = 'button',
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .btn {
    --pad-y: 0.7em;
    --pad-x: 1.5em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    padding: var(--pad-y) var(--pad-x);
    border-radius: var(--radius-pill);
    font: inherit;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: transform var(--transition), background var(--transition),
      color var(--transition), border-color var(--transition), box-shadow var(--transition);
  }
  .btn--lg { --pad-y: 0.95em; --pad-x: 2em; font-size: var(--step-0); }
  .btn:hover { transform: translateY(-2px) scale(1.03); }
  .btn:active { transform: translateY(0) scale(0.97); transition-duration: 90ms; }

  .btn--primary {
    background: var(--brand);
    color: #fff;
    box-shadow: 0 8px 24px -10px var(--brand);
  }
  .btn--primary:hover { background: var(--brand-strong); color: #fff; }

  .btn--outline {
    border-color: var(--brand);
    color: var(--brand);
    background: transparent;
  }
  .btn--outline:hover { background: var(--brand); color: #fff; }

  .btn--ghost {
    background: var(--bg-elev-2);
    color: var(--text);
    border-color: var(--border);
  }
  .btn--ghost:hover { border-color: var(--brand); color: var(--brand); }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover, .btn:active { transform: none; }
  }
</style>
