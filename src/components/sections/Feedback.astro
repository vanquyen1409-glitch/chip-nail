---
import { testimonials } from '../../config/content';
import SectionTitle from '../ui/SectionTitle.astro';
import T from '../ui/T.astro';
---
<section id="feedback" class="feedback section">
  <div class="container">
    <SectionTitle
      eyebrow={{ vi: 'Cảm nhận khách hàng', en: 'Testimonials' }}
      title={{ vi: 'Khách hàng nói gì về chúng tôi', en: 'What our guests say' }}
      subtitle={{ vi: 'Những chia sẻ chân thật giúp chúng tôi mỗi ngày hoàn thiện hơn.', en: 'Honest words that help us improve every day.' }}
    />

    <div class="feedback__grid">
      {testimonials.map((t, i) => (
        <figure class="review" data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <div class="review__stars" aria-label={`${t.rating} out of 5 stars`}>
            {Array.from({ length: 5 }).map((_, s) => (
              <svg aria-hidden="true" class:list={['star', { 'is-on': s < t.rating }]} viewBox="0 0 24 24"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
            ))}
          </div>
          <blockquote class="review__quote">“<T vi={t.quote.vi} en={t.quote.en} />”</blockquote>
          <figcaption class="review__person">
            <span class="review__avatar" aria-hidden="true">{t.name.en.trim().slice(-1)}</span>
            <span>
              <strong class="review__name"><T vi={t.name.vi} en={t.name.en} /></strong>
              <span class="review__role"><T vi={t.role.vi} en={t.role.en} /></span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .feedback__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .review {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem;
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .review:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .review__stars { display: flex; gap: 3px; }
  .star { width: 18px; height: 18px; fill: var(--border); }
  .star.is-on { fill: #f5b942; }
  .review__quote {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--text);
    flex: 1;
  }
  .review__person { display: flex; align-items: center; gap: 0.8rem; margin-top: auto; }
  .review__avatar {
    width: 56px; height: 56px; flex: 0 0 56px;
    border-radius: 50%;
    display: grid; place-items: center;
    background: var(--brand-tint);
    color: var(--brand);
    font-family: var(--font-display);
    font-weight: 700; font-size: 1.3rem;
  }
  .review__name { display: block; color: var(--text); }
  .review__role { font-size: 0.8rem; color: var(--text-muted); }

  @media (max-width: 980px) { .feedback__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .feedback__grid { grid-template-columns: 1fr; max-width: 420px; margin-inline: auto; } }
  @media (prefers-reduced-motion: reduce) { .review:hover { transform: none; } }
</style>
