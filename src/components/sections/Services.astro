---
import { serviceGroups, serviceNote } from '../../config/content';
import { contact, bookingUrl } from '../../config/site';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import T from '../ui/T.astro';
const bookExt = bookingUrl.startsWith('http');
---
<section id="services" class="services section">
  <div class="container">
    <SectionTitle
      eyebrow={{ vi: 'Bảng giá', en: 'Pricing' }}
      title={{ vi: 'Dịch vụ & bảng giá', en: 'Services & Pricing' }}
      subtitle={serviceNote}
    />

    <div class="services__grid">
      {serviceGroups.map((group, gi) => (
        <article class="price-card" data-reveal data-reveal-delay={String((gi % 3) + 1)}>
          <h3 class="price-card__title"><T vi={group.name.vi} en={group.name.en} /></h3>
          <ul class="price-list">
            {group.items.map((item) => (
              <li class="price-row">
                <span class="price-row__name">
                  <T vi={item.name.vi} en={item.name.en} />
                  {item.note && <span class="price-row__note"><T vi={item.note.vi} en={item.note.en} /></span>}
                </span>
                <span class="price-row__dots" aria-hidden="true"></span>
                <span class="price-row__price"><T vi={item.price.vi} en={item.price.en} /></span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="services__cta" data-reveal>
      <p>
        <T vi="Muốn mẫu riêng theo ý bạn? Gọi" en="Want a custom design? Call" />
        <a href={`tel:${contact.phoneTel}`}>{contact.phoneLabel}</a>
        <T vi="để được tư vấn." en="for a consultation." />
      </p>
      <Button href={bookingUrl} target={bookExt ? '_blank' : undefined} rel={bookExt ? 'noopener' : undefined} variant="primary" size="lg"><T vi="Đặt lịch ngay" en="Book now" /></Button>
    </div>
  </div>
</section>

<style>
  .services { background: var(--bg-elev); }
  /* Nhiều nhóm -> xếp dạng cột tự cân (masonry) để không bị khoảng trống */
  .services__grid {
    columns: 3 300px;
    column-gap: clamp(1.2rem, 2.5vw, 2rem);
  }
  .price-card {
    break-inside: avoid;
    width: 100%;
    margin-bottom: clamp(1.2rem, 2.5vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 3vw, 2rem);
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }
  .price-card:hover {
    transform: translateY(-6px);
    border-color: var(--brand);
    box-shadow: var(--shadow);
  }
  .price-card__title {
    font-size: var(--step-1);
    padding-bottom: 0.9rem;
    margin-bottom: 0.4rem;
    border-bottom: 2px solid var(--brand-tint);
  }
  .price-row {
    display: flex; align-items: baseline; gap: 0.5rem;
    padding: 0.7rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .price-row:last-child { border-bottom: 0; }
  .price-row__name { color: var(--text); font-weight: 500; display: flex; flex-direction: column; }
  .price-row__note { font-size: 0.72rem; color: var(--brand); font-weight: 600; }
  .price-row__dots { flex: 1; border-bottom: 1px dotted var(--border); transform: translateY(-3px); }
  .price-row__price { color: var(--text); font-weight: 700; white-space: nowrap; }

  .services__cta {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 1rem 1.5rem; text-align: center;
  }
  .services__cta p { margin: 0; }
  .services__cta p a { color: var(--brand); font-weight: 700; }

  @media (max-width: 680px) { .services__grid { columns: 1; max-width: 520px; margin-inline: auto; } }
  @media (prefers-reduced-motion: reduce) { .price-card:hover { transform: none; } }
</style>
