---
import { gallery } from '../../config/content';
import SectionTitle from '../ui/SectionTitle.astro';
import T from '../ui/T.astro';
---
<section id="gallery" class="gallery section">
  <div class="container">
    <SectionTitle
      eyebrow={{ vi: 'Hình ảnh hoạt động', en: 'Our work' }}
      title={{ vi: 'Một vài tác phẩm tại tiệm', en: 'A few looks from the studio' }}
      subtitle={{ vi: 'Hình ảnh mang tính minh họa — bạn có thể thay bằng ảnh thật của tiệm mình.', en: 'Images are illustrative — replace them with your salon’s own photos.' }}
    />

    <div class="gallery__grid">
      {gallery.map((g, i) => (
        <figure class:list={['g-item', `is-${g.span}`]} data-reveal data-reveal-delay={String((i % 4) + 1)}>
          <img src={g.image} alt={g.alt.vi} loading="lazy" />
          <figcaption><T vi={g.alt.vi} en={g.alt.en} /></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--bg-elev); }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 180px;
    grid-auto-flow: dense;
    gap: clamp(0.6rem, 1.5vw, 1rem);
  }
  .g-item {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .g-item.is-tall { grid-row: span 2; }
  .g-item.is-wide { grid-column: span 2; }
  .g-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .g-item:hover img { transform: scale(1.08); }
  .g-item figcaption {
    position: absolute; inset: auto 0 0 0;
    padding: 1.4rem 1rem 0.8rem;
    font-size: 0.85rem;
    color: #fff;
    background: linear-gradient(to top, hsl(252 24% 4% / 0.85), transparent);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--transition), transform var(--transition);
  }
  .g-item:hover figcaption { opacity: 1; transform: none; }

  @media (max-width: 820px) {
    .gallery__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 150px; }
    .g-item.is-wide { grid-column: span 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .g-item:hover img { transform: none; }
  }
</style>
