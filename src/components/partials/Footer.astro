---
import { site, contact, socials, nav } from '../../config/site';
import Button from '../ui/Button.astro';
import T from '../ui/T.astro';

const socialLinks = [
  { key: 'facebook', label: 'Facebook', href: socials.facebook, icon: 'f' },
  { key: 'instagram', label: 'Instagram', href: socials.instagram, icon: '◎' },
  { key: 'tiktok', label: 'TikTok', href: socials.tiktok, icon: '♪' },
  { key: 'zalo', label: 'Zalo', href: socials.zalo, icon: 'Z' },
].filter((s) => s.href && s.href !== '#');
---
<!-- Dải liên hệ (anchor #contact) -->
<section id="contact" class="contact-band">
  <div class="container contact-band__inner" data-reveal>
    <div>
      <span class="eyebrow"><T vi="Liên hệ & Đặt lịch" en="Contact & Booking" /></span>
      <h2><T vi="Sẵn sàng làm đẹp đôi tay bạn?" en="Ready to pamper your hands?" /></h2>
      <p><T vi="Đặt lịch trước để được phục vụ ngay khi đến, không phải chờ đợi." en="Book ahead and get served as soon as you arrive — no waiting." /></p>
    </div>
    <div class="contact-band__actions">
      <Button href={`tel:${contact.phoneTel}`} variant="primary" size="lg"><T vi={`Gọi ${contact.phoneLabel}`} en={`Call ${contact.phoneLabel}`} /></Button>
      <Button href={`sms:${contact.phoneTel}`} variant="outline" size="lg"><T vi="Nhắn tin (SMS)" en="Text us" /></Button>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <span class="footer__name">{site.name}</span>
      <p class="footer__blurb"><T vi={`${site.tagline.vi}. ${site.description.vi}`} en={`${site.tagline.en}. ${site.description.en}`} /></p>
      {socialLinks.length > 0 && (
        <ul class="footer__socials" aria-label="Mạng xã hội">
          {socialLinks.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
                <span aria-hidden="true">{s.icon}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="footer__col">
      <h3><T vi="Liên hệ" en="Contact" /></h3>
      <ul class="footer__list">
        <li>
          <svg class="footer__ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
          <a href={contact.mapUrl} target="_blank" rel="noopener">{contact.address}</a>
        </li>
        <li>
          <svg class="footer__ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.5.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.57 3.5a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
          <a href={`tel:${contact.phoneTel}`}>{contact.phoneLabel}</a>
        </li>
        <li>
          <svg class="footer__ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 7L4 6.2V18h16V6.2L12 11z"/></svg>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
      </ul>
    </div>

    <div class="footer__col">
      <h3><T vi="Giờ mở cửa" en="Opening hours" /></h3>
      <ul class="footer__list">
        {contact.hours.map((h) => (
          <li><span><T vi={h.days.vi} en={h.days.en} /></span><strong>{h.time}</strong></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h3><T vi="Liên kết" en="Links" /></h3>
      <ul class="footer__list footer__nav">
        {nav.map((item) => (<li><a href={item.href}><T vi={item.label.vi} en={item.label.en} /></a></li>))}
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p>© {site.year} {site.name}. <T vi="Bảo lưu mọi quyền." en="All rights reserved." /></p>
    </div>
  </div>
</footer>

<style>
  /* Contact band */
  .contact-band { background: var(--brand-tint); border-top: 1px solid var(--border); }
  .contact-band__inner {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1.5rem;
  }
  .contact-band h2 { margin: 0.3rem 0 0.5rem; }
  .contact-band p { margin: 0; max-width: 46ch; }
  .contact-band__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  /* Footer */
  .footer { background: var(--bg-elev); color: var(--text); border-top: 1px solid var(--border); }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .footer__name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--text); }
  .footer__blurb { margin: 0.8rem 0 1.2rem; font-size: 0.9rem; max-width: 42ch; }
  .footer__socials { display: flex; gap: 0.6rem; }
  .footer__socials a {
    display: grid; place-items: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 700;
    transition: background var(--transition), color var(--transition), transform var(--transition);
  }
  .footer__socials a:hover { background: var(--brand); color: #fff; transform: translateY(-3px); }

  .footer__col h3 { font-size: 1rem; margin-bottom: 1rem; color: var(--text); }
  .footer__list { display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.9rem; }
  .footer__list li { color: var(--text-muted); display: flex; gap: 0.6rem; align-items: flex-start; }
  .footer__ic { flex: 0 0 18px; width: 18px; height: 18px; fill: var(--brand); margin-top: 2px; }
  .footer__list a { color: var(--text-muted); }
  .footer__list a:hover { color: var(--brand); }
  .footer__col:nth-child(3) .footer__list li { justify-content: space-between; }
  .footer__col:nth-child(3) strong { color: var(--text); }
  .footer__nav a { color: var(--text-muted); }

  .footer__bottom { border-top: 1px solid var(--border); padding-block: 1.2rem; }
  .footer__bottom p { margin: 0; font-size: 0.82rem; text-align: center; color: var(--text-muted); }

  @media (max-width: 820px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .contact-band__inner { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 480px) { .footer__grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .footer__socials a:hover { transform: none; } }
</style>
