---
import { site, nav, contact, bookingUrl } from '../../config/site';
import ThemeToggle from './ThemeToggle.astro';
import Button from '../ui/Button.astro';
import T from '../ui/T.astro';
const bookExt = bookingUrl.startsWith('http');
---
<header class="header" id="site-header">
  <div class="container header__inner">
    <!-- Logo dạng chữ (placeholder thương hiệu) -->
    <a href="#hero" class="brand" aria-label={`${site.name} - home`}>
      <span class="brand__mark" aria-hidden="true">C</span>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__tag"><T vi={site.tagline.vi} en={site.tagline.en} /></span>
      </span>
    </a>

    <!-- Menu desktop -->
    <nav class="nav-desktop" aria-label="Main navigation">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} class="nav-link"><T vi={item.label.vi} en={item.label.en} /></a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <ThemeToggle />
      <Button href={bookingUrl} target={bookExt ? '_blank' : undefined} rel={bookExt ? 'noopener' : undefined} variant="primary" class="header__cta"><T vi="Đặt lịch" en="Book now" /></Button>
      <button
        id="menu-open"
        class="hamburger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menu mobile dạng overlay trượt -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="mobile-menu__top">
        <span class="brand__name">{site.name}</span>
        <button id="menu-close" class="m-close" type="button" aria-label="Close menu">&#215;</button>
      </div>
      <nav aria-label="Mobile navigation">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} class="m-link" data-close><T vi={item.label.vi} en={item.label.en} /></a></li>
          ))}
        </ul>
      </nav>
      <a href={`tel:${contact.phoneTel}`} class="m-call">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.5.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.57 3.5a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
        {contact.phoneLabel}
      </a>
      <Button href={bookingUrl} target={bookExt ? '_blank' : undefined} rel={bookExt ? 'noopener' : undefined} variant="primary" size="lg" class="m-cta" data-close><T vi="Đặt lịch ngay" en="Book now" /></Button>
    </div>
    <button class="mobile-menu__backdrop" id="menu-backdrop" aria-label="Close menu" tabindex="-1"></button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
  }
  .header.is-scrolled {
    border-bottom-color: var(--border);
    box-shadow: var(--shadow);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
    transition: min-height 0.3s ease;
  }
  /* Thu gọn nhẹ khi cuộn */
  .header.is-scrolled .header__inner { min-height: 60px; }
  .brand__mark, .brand__name { transition: transform 0.3s ease; transform-origin: left center; }
  .header.is-scrolled .brand__mark { transform: scale(0.88); }
  .header.is-scrolled .brand__name { transform: scale(0.94); }

  /* Brand */
  .brand { display: flex; align-items: center; gap: 0.6rem; }
  .brand__mark {
    display: grid; place-items: center;
    width: 42px; height: 42px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--brand-soft), var(--brand-strong));
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1;
    box-shadow: 0 6px 18px -9px var(--brand), inset 0 0 0 2px hsl(0 0% 100% / 0.18);
  }
  .brand__text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand__name { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: var(--text); letter-spacing: 0.01em; }
  .brand__tag { font-size: 0.7rem; color: var(--text-muted); letter-spacing: 0.04em; }

  /* Desktop nav */
  .nav-desktop ul { display: flex; gap: clamp(0.8rem, 2vw, 1.8rem); align-items: center; }
  .nav-link {
    position: relative;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text);
    padding: 0.4rem 0;
  }
  .nav-link::after {
    content: '';
    position: absolute; left: 0; bottom: -2px;
    width: 0; height: 2px; background: var(--brand);
    transition: width var(--transition);
  }
  .nav-link:hover::after { width: 100%; }

  .header__actions { display: flex; align-items: center; gap: 0.65rem; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px; height: 42px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--bg-elev-2);
    cursor: pointer;
  }
  .hamburger span {
    display: block; width: 18px; height: 2px;
    margin-inline: auto;
    background: var(--text); border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }

  /* Mobile overlay */
  .mobile-menu { position: fixed; inset: 0; z-index: 200; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__backdrop {
    position: absolute; inset: 0;
    border: 0; padding: 0;
    background: var(--overlay);
    cursor: pointer;
    animation: fade 0.25s ease;
  }
  .mobile-menu__panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: min(82vw, 340px);
    background: var(--bg-elev);
    border-left: 1px solid var(--border);
    padding: 1.5rem 1.5rem 2rem;
    display: flex; flex-direction: column; gap: 1.2rem;
    box-shadow: var(--shadow);
    animation: slidein 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-menu__top { display: flex; align-items: center; justify-content: space-between; }
  .m-close {
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-elev-2);
    color: var(--text); font-size: 1rem; cursor: pointer;
  }
  .mobile-menu__panel nav ul { display: flex; flex-direction: column; gap: 0.3rem; }
  .m-link {
    display: block;
    padding: 0.7rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 1.05rem; font-weight: 500;
    color: var(--text);
  }
  .m-link:hover { background: var(--brand-tint); color: var(--brand); }
  /* Stagger các mục menu khi mở */
  .mobile-menu:not([hidden]) .m-link { animation: mlinkin 0.42s ease-out backwards; }
  .mobile-menu__panel nav li:nth-child(1) .m-link { animation-delay: 0.12s; }
  .mobile-menu__panel nav li:nth-child(2) .m-link { animation-delay: 0.17s; }
  .mobile-menu__panel nav li:nth-child(3) .m-link { animation-delay: 0.22s; }
  .mobile-menu__panel nav li:nth-child(4) .m-link { animation-delay: 0.27s; }
  .mobile-menu__panel nav li:nth-child(5) .m-link { animation-delay: 0.32s; }
  .mobile-menu__panel nav li:nth-child(6) .m-link { animation-delay: 0.37s; }
  @keyframes mlinkin { from { opacity: 0; transform: translateX(18px); } to { opacity: 1; transform: none; } }
  .m-call {
    margin-top: auto;
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: var(--brand); font-weight: 600;
    padding: 0.5rem 0.6rem;
  }
  .m-call svg { width: 18px; height: 18px; fill: currentColor; }
  .m-cta { width: 100%; }

  @keyframes slidein { from { transform: translateX(100%); } to { transform: none; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }

  /* Breakpoint: mobile */
  @media (max-width: 860px) {
    .nav-desktop { display: none; }
    .header__cta { display: none; }
    .hamburger { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__panel, .mobile-menu__backdrop { animation: none; }
    .mobile-menu:not([hidden]) .m-link { animation: none; opacity: 1; transform: none; }
    .header__inner, .brand__mark, .brand__name { transition: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const menu = document.getElementById('mobile-menu');
  const openBtn = document.getElementById('menu-open');
  const closeEls = document.querySelectorAll('#menu-close, #menu-backdrop, [data-close]');

  // bóng header khi cuộn
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const open = () => {
    if (!menu) return;
    menu.hidden = false;
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    if (!menu) return;
    menu.hidden = true;
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };
  openBtn?.addEventListener('click', open);
  closeEls.forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>
